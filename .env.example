# --- core ---------------------------------------------------------------
DATABASE_URL=postgres://sinapse_owner:change-me@localhost:5432/sinapse
# Optional read replica for reporting; falls back to DATABASE_URL
ANALYTICS_DATABASE_URL=
# Optional: if unset, a strong secret is generated on first start and stored in the database
JWT_SECRET=
PUBLIC_URL=https://crm.namport.com.na
PORT=4000
OBJECT_STORAGE_DIR=/var/lib/sinapse/storage
RUN_SCHEDULER=true
# Reference configuration is loaded on every start (idempotent); set SEED_DEMO=true to also load demo data once
SEED_DEMO=false
# Set to false once Entra ID SSO is live to disable password sign-in for staff
ALLOW_LOCAL_LOGIN=true

# --- Microsoft Entra ID / Graph (SSO, shared mailbox, calendars) -----------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://crm.namport.com.na/api/v1/auth/entra/callback
GRAPH_SHARED_MAILBOX=customercare@namport.com.na
SCIM_TOKEN=

# --- Microsoft Teams (incoming webhook / Workflows URL) ---------------------
TEAMS_WEBHOOK_URL=

# --- SAP S/4HANA OData ---------------------------------------------------------
SAP_ODATA_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=

# --- Antivirus (clamd) ---------------------------------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Sinapse Assist phrasing (optional; retrieval and grounding are always local)
ANTHROPIC_API_KEY=
ASSIST_MODEL=claude-opus-5-5
